generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Use POSTGRES_PRISMA_URL (from Neon/Vercel integration) or fall back to DATABASE_URL (local dev)
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Score {
  id           String   @id @default(uuid())
  gameId       String   @map("game_id")
  puzzleId     String   @map("puzzle_id")
  puzzleNumber Int      @map("puzzle_number")
  score        Int
  submittedAt  DateTime @default(now()) @map("submitted_at")

  @@index([gameId, puzzleId, score(sort: Desc)])
  @@map("scores")
}
