# PostgreSQL connection strings
# Uses Neon's variable naming convention for compatibility

# For local development with docker-compose:
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5433/grid_games"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5433/grid_games"

# For Neon production, these are automatically set by the Vercel integration
