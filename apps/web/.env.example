# Feedback/Bug Report email configuration
# Get API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email address to receive feedback and bug reports
FEEDBACK_EMAIL=your-email@example.com

# PostgreSQL connection for top scores feature
# For local development with docker-compose, use:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/grid_games"
